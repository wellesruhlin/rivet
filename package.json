{
  "name": "arc-cpq",
  "private": true,
  "type": "module",
  "description": "Arc CPQ: shared configurator engine, geometry, brand packs and apps.",
  "workspaces": [
    "packages/*",
    "brands/*",
    "apps/on3p",
    "apps/praxis",
    "apps/proteus",
    "apps/outreach",
    "apps/maker-studio",
    "labs/on3p-ski-lab"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "build": "npm run build -w apps/on3p -w apps/praxis -w apps/proteus -w apps/outreach -w apps/maker-studio",
    "dev:on3p": "npm run dev -w apps/on3p -- --port 5178",
    "dev:praxis": "npm run dev -w apps/praxis -- --port 5181",
    "dev:proteus": "npm run dev -w apps/proteus -- --port 5182",
    "dev:outreach": "npm run dev -w apps/outreach",
    "dev:maker": "npm run dev -w apps/maker-studio",
    "server:maker": "npm run server -w apps/maker-studio",
    "qa:on3p": "node qa/on3p-parity.mjs",
    "qa:praxis": "node qa/praxis.mjs",
    "qa:proteus": "node qa/proteus.mjs",
    "qa:outreach": "node qa/outreach.mjs",
    "screenshots": "node qa/screenshots.mjs qa/screenshots"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
