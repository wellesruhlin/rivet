# Same source bytes on Windows and Linux; no CRLF-only diffs.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diff or normalize.
*.blend binary
*.glb binary
*.gltf -text
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.zip binary
*.tar binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.hdr binary
*.exr binary
