{
  "name": "@arc/brand-praxis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Praxis Skis brand pack: the custom-ski catalog and rules, traced shapes, veneers and artwork, bindings, the in-stock catalog and the configurator guides. Independent concept; not affiliated with Praxis.",
  "exports": {
    ".": "./src/configurator/index.js",
    "./pack": "./src/configurator/pack.js",
    "./guides": "./src/configurator/guides.jsx",
    "./bindings": "./src/configurator/bindings.js",
    "./geometry": "./src/configurator/geometry.js",
    "./construction": "./src/configurator/construction.js",
    "./catalog": "./src/catalog/index.js"
  },
  "dependencies": {
    "@arc/configurator": "*",
    "@arc/ski-geometry": "*"
  },
  "peerDependencies": {
    "react": ">=19",
    "lucide-react": ">=0.468.0"
  },
  "scripts": {
    "test": "node --test src/configurator/pack.test.js src/configurator/studio.test.js src/catalog/catalog.test.js",
    "import": "node scripts/import-catalog.mjs",
    "art": "node scripts/fetch-art.mjs && node scripts/trace-outlines.mjs && node scripts/build-art.mjs",
    "bindings": "node scripts/import-bindings.mjs"
  },
  "devDependencies": {
    "node-html-parser": "^7.0.1",
    "sharp": "^0.34.5"
  }
}
